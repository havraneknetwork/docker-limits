# ==============================================================================
# Docker Limits Manager - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your values before starting the container:
# cp .env.example .env

# Server & Network Binding
# LIMITS_BIND_IP: IP address to bind to (use 0.0.0.0 for all interfaces or specific host IP)
LIMITS_BIND_IP=0.0.0.0
# LIMITS_HOST_PORT: Host port mapped to the web dashboard and REST API
LIMITS_HOST_PORT=8000
# LIMITS_PORT: Internal container port (default: 8000)
LIMITS_PORT=8000

# Docker Compose Path Synchronization
# HOST_PROJECTS_DIR: Host filesystem directory where your compose projects reside
HOST_PROJECTS_DIR=/home/user
# ALLOWED_HOST_ROOT: Root boundary directory inside the container for safety checks
ALLOWED_HOST_ROOT=/home/user

# Authentication & Security Keys
# LIMITS_API_KEY: Secret key for API clients passing X-API-Key header
LIMITS_API_KEY=your-custom-api-secret-key-change-me

# SESSION_SECRET_KEY: Secret key for signing web session cookies (HMAC-SHA256)
SESSION_SECRET_KEY=your-secure-random-session-secret-change-me

# Admin Web Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session & Brute-force Protection
SESSION_LIFETIME_HOURS=72
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
IP_RATE_LIMIT_ATTEMPTS=10
IP_RATE_LIMIT_MINUTES=15
